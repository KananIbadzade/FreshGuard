{
  "name": "freshguard",
  "version": "0.1.0",
  "private": true,
  "description": "MCP tools that reject agent writes based on a stale read, with a READ_AND_REPLAN signal the agent can act on.",
  "keywords": [
    "mcp",
    "agents",
    "ai-safety",
    "optimistic-concurrency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KananIbadzade/FreshGuard.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "freshguard-mcp": "mcp/server.mjs"
  },
  "files": [
    "mcp/",
    "convex/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:convex": "convex dev",
    "dev:agent": "node --env-file=.env.local agent/http.ts",
    "dev:ui": "vite",
    "test": "npm run test:writes && npm run test:race && npm run test:mcp && npm run test:agent && npm run test:http",
    "test:live": "LIVE=1 npm test",
    "test:writes": "node --env-file=.env.local scripts/test-writes.mjs",
    "test:mcp": "node --env-file=.env.local scripts/test-mcp.mjs",
    "test:agent": "node --env-file=.env.local scripts/test-agent.mjs",
    "test:http": "node --env-file=.env.local scripts/test-http.mjs",
    "test:race": "node --env-file=.env.local scripts/race-test.mjs",
    "agent": "node --env-file=.env.local agent/cli.ts",
    "reprice": "node --env-file=.env.local scripts/cursor-reprice.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.67.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "convex": "1.49.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "7.3.7"
  }
}
